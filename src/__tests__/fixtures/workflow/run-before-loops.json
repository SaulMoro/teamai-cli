  "definition": {
    "schemaVersion": "v1alpha1",
    "name": "legacy",
    "description": "A run file written before loops and for_each.",
    "steps": [
      {
        "id": "build",
        "command": "node -e \"process.stdout.write(JSON.stringify({artifact:'app.tgz'}))\"",
        "output": {
          "type": "object",
          "fields": {
            "artifact": {
              "type": "string"
            }
          }
        }
      },
      {
        "id": "check",
        "needs": [
          "build"
        ],
        "workflow": {
          "ends": {
            "ready": "succeeded"
          },
          "outputs": {
            "verdict": "steps.classify.outputs.verdict"
          },
          "steps": [
            {
              "id": "classify",
              "command": "node -e \"process.stdout.write(JSON.stringify({verdict:'ship'}))\"",
              "output": {
                "type": "object",
                "fields": {
                  "verdict": {
                    "type": "string"
                  }
                }
              }
            },
            {
              "id": "done",
              "needs": [
                "classify"
              ],
              "end": "ready"
            }
          ]
        }
      },
      {
        "id": "ship",
        "needs": [
          "check"
        ],
        "command": "node -e \"require('fs').writeFileSync('shipped.txt', process.env.ARTIFACT)\"",
        "env": {
          "ARTIFACT": "{{ steps.build.outputs.artifact }}"
        }
      }
    ]
  },
  "steps": [
    {
      "id": "build",
      "status": "succeeded",
      "exitCode": 0,
      "outcome": "success",
      "outputs": {
        "artifact": "app.tgz"
      }
    },
    {
      "id": "check",
      "status": "succeeded",
      "outcome": "success",
      "end": "ready",
      "outputs": {
        "verdict": "ship"
      }
    },
    {
      "id": "check.classify",
      "status": "succeeded",
      "exitCode": 0,
      "outcome": "success",
      "outputs": {
        "verdict": "ship"
      }
    },
    {
      "id": "check.done",
      "status": "succeeded"
    },
    {
      "id": "ship",
      "status": "pending",
      "exitCode": 130,
      "message": "driver stopped before the step finished",
      "outcome": "released"
    }
  ],
